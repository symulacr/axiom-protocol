{
  "name": "@axiom/config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared configuration for the Axiom Protocol — env loader, network defaults, deployed addresses.",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./constants": "./dist/constants.js",
    "./eip712": "./dist/eip712.js",
    "./crypto/aes-gcm": "./dist/crypto/aes-gcm.js",
    "./crypto/keys": "./dist/crypto/keys.js",
    "./env": "./dist/env.js",
    "./networks": "./dist/networks.js",
    "./addresses": "./dist/addresses.js",
    "./types/hex": "./dist/types/hex.js",
    "./types/contract": "./dist/types/contract.js",
    "./abis": "./dist/abis/index.js",
    "./middleware/auth": "./dist/middleware/auth.js",
    "./env-schema": "./dist/env-schema.js",
    "./storage/0g": "./dist/storage/0g.js",
    "./types/performance": "./dist/types/performance.js",
    "./types/orchestrator": "./dist/types/orchestrator.js",
    "./types/transfer": "./dist/types/transfer.js",
    "./process": "./dist/process.js",
    "./chat-tools": "./dist/chat-tools.js",
    "./skills/schemas": "./dist/skills/schemas.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test $(find src test -name '*.test.ts' 2>/dev/null | sort)"
  },
  "dependencies": {
    "@0gfoundation/0g-storage-ts-sdk": "^1.2.10",
    "eciesjs": "^0.4.18",
    "ethereum-cryptography": "^2.2.1",
    "ethers": "^6.16.0",
    "viem": "^2.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "express": "^4.21.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT"
}
