{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "noImplicitAny": false,
    "outDir": "./dist",
    "rootDir": "./scripts",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024"],
    "types": ["node"],
    "noEmit": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["scripts/**/*.js"],
  "exclude": ["node_modules", "dist"]
}
