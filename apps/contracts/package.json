{
  "name": "@axiom/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Axiom Protocol smart contracts — AxiomAgentNFT (ERC-7857), AxiomStrategyVault, AxiomPaymentProcessor, AxiomTeeVerifier",
  "license": "MIT",
  "main": "index.js",
  "scripts": {
    "build": "forge build && bash scripts/generate-abis.sh",
    "test": "forge test -vv",
    "generate-abis": "bash scripts/generate-abis.sh",
    "precompile-artifacts": "bash scripts/precompile-artifacts.sh",
    "mint-e2e-usdc": "forge script script/MintE2eUsdc.s.sol --rpc-url ${OG_RPC_URL:-https://evmrpc-testnet.0g.ai} --chain-id 16602 --broadcast --priority-gas-price 2000000000 --legacy --slow",
    "coverage": "forge coverage",
    "format": "forge fmt",
    "format:check": "forge fmt --check",
    "lint:sol": "solhint 'src/**/*.sol' 'test/**/*.sol' 'script/**/*.sol'",
    "lint:fix": "solhint --fix 'src/**/*.sol' 'test/**/*.sol' 'script/**/*.sol'",
    "lint": "forge fmt --check",
    "typecheck": "tsc --noEmit",
    "deploy:galileo": "forge script script/Deploy.s.sol --rpc-url ${OG_RPC_URL:-https://evmrpc-testnet.0g.ai} --chain-id 16602 --broadcast --priority-gas-price 3000000000 --legacy --slow",
    "verify:galileo": "hardhat verify --network galileo",
    "deploy:mainnet": "forge script script/DeployAristotle.s.sol --rpc-url ${OG_RPC_URL:-https://evmrpc.0g.ai} --chain-id 16661 --broadcast --slow",
    "verify:mainnet": "hardhat verify --network mainnet"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@openzeppelin/contracts-upgradeable": "5.6.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-verify": "^2.0.10",
    "@types/node": "^22.20.1",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "hardhat": "^2.29.0",
    "solhint": "^5.0.0",
    "typescript": "^5.9.3"
  }
}
