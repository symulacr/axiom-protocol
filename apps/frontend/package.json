{
  "name": "@axiom/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "description": "Axiom Protocol iNFT agent dashboard — Bun + React 19 + wagmi v3",
  "scripts": {
    "dev": "bun --hot run dev.mjs",
    "build": "tsc --project tsconfig.json && bun build.mjs",
    "preview": "bun dev.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "coverage-status": "bun run --filter @axiom/backend coverage-status --manifest frontend-prod",
    "test": "bun test src"
  },
  "dependencies": {
    "@axiom/chat-runtime": "workspace:*",
    "@axiom/config": "workspace:*",
    "@tanstack/react-query": "5.102.8",
    "@walletconnect/ethereum-provider": "^2.23.10",
    "border-beam": "1.3.0",
    "dompurify": "^3.4.14",
    "liquid-gooey": "0.2.1",
    "marked": "18.0.11",
    "metal-fx": "2.0.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "sonner": "^2.0.8",
    "thinking-orbs": "0.3.1",
    "three": "^0.185.1",
    "viem": "2.56.0",
    "wagmi": "^3.7.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.4",
    "eslint": "^9.39.5",
    "typescript-eslint": "^8.68.0"
  },
  "license": "MIT"
}
