{
  "name": "@axiom/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "description": "Axiom Protocol iNFT agent dashboard — Vite + React 18 + wagmi v2 + RainbowKit v2",
  "scripts": {
    "dev": "vite",
    "build": "tsc --project tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "coverage-status": "pnpm --filter @axiom/backend exec node --import tsx src/cli/coverage-status.ts --manifest frontend-prod",
    "test": "node --test src/hooks/useTransfer.dataHash.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@axiom/chat-runtime": "workspace:*",
    "@axiom/config": "workspace:*",
    "@rainbow-me/rainbowkit": "^2.2.1",
    "@tanstack/react-query": "^5.59.0",
    "dompurify": "^3.4.11",
    "marked": "^18.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.17.0",
    "sonner": "^2.0.7",
    "viem": "^2.21.45",
    "wagmi": "^2.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.14.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.62.1",
    "vite": "^5.4.10"
  },
  "license": "MIT"
}
