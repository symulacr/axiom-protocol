# Axiom FE — Aristotle mainnet (chain 16661) env template.
# PLACEHOLDERS: fill the addresses from the post-DeployAristotle deployment JSON
# (expected at docs/deployments/aristotle-v3-<date>.json) before any mainnet build.
# Note build.mjs inlines VITE_* from the REPO ROOT .env — merge these there for builds.

# --- chain ---
# Default when VITE_CHAIN_ID is unset is also 16661 (resolveChainId fallback),
# so a mainnet build only strictly needs the addresses below.
VITE_CHAIN_ID=16661
# Allowlisted RPCs for 16661 (wagmi.tsx): https://evmrpc.0g.ai, https://rpc.0g.ai
VITE_EVM_RPC=https://evmrpc.0g.ai

# --- contracts (TO BE FILLED after the DeployAristotle run) ---
VITE_AGENT_NFT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_STRATEGY_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_TEE_VERIFIER_ADDRESS=0x0000000000000000000000000000000000000000
VITE_PAYMENT_PROCESSOR_ADDRESS=0x0000000000000000000000000000000000000000
VITE_DELEGATION_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
VITE_GAS_TANK_ADDRESS=0x0000000000000000000000000000000000000000

# --- reused / off-suite (chain-invariant, not env vars) ---
# Permit2 (canonical CREATE2): 0x000000000022D473030F116dDEE9F6B43aC78BA3

# --- services (fill per deployment; optional) ---
# VITE_BACKEND_URL=https://axiom-backend-production-4ac3.up.railway.app
# VITE_API_KEY=
# VITE_ORACLE_URL=/oracle
# VITE_WALLETCONNECT_PROJECT_ID=
