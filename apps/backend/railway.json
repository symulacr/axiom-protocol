{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "bun run --filter @axiom/backend build:binary"
  },
  "deploy": {
    "startCommand": "./dist/axiom-backend",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicy": "ON_FAILURE"
  },
  "watchPatterns": ["apps/backend/**", "packages/config/**", "packages/chat-runtime/**"]
}
