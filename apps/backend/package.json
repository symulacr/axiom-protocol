{
  "name": "@axiom/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Axiom Protocol orchestration engine + HTTP/WS server",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:binary": "NODE_ENV=production bun build src/index.ts --compile --target=bun --minify --outfile=../../dist/axiom-backend",
    "start": "bun dist/index.js",
    "start:binary": "BUN_DISABLE_NODE_API=1 bun dist/axiom-backend",
    "prestart": "bun run build",
    "dev": "bun run src/index.ts",
    "test": "AXIOM_API_KEY= AXIOM_CLIENT_API_KEY= bun test --parallel --max-concurrency=1",
    "test:openapi": "bun test src/server/openapi-wiring.test.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc --project tsconfig.e2e.json",
    "pre-run-e2e": "bun run --filter @axiom/chat-runtime build && bun run build",
    "run-e2e": "bun run e2e/run-e2e.ts",
    "run-chat-bench": "bun run e2e/run-chat-bench.ts",
    "run-chat-bench:live": "E2E_LIVE_COMPUTE=1 bun run e2e/run-chat-bench.ts",
    "run-load-bench": "bun run e2e/run-load-bench.ts",
    "generate:openapi": "bun scripts/generate-openapi.mjs",
    "coverage-status": "bun run e2e/coverage-status.ts",
    "provision-e2e-wallet": "bun run e2e/provision-e2e-wallet.ts",
    "fund-e2e-usdc": "bun run e2e/fund-e2e-usdc.ts"
  },
  "dependencies": {
    "@axiom/chat-runtime": "workspace:*",
    "@axiom/config": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "compression": "^1.7.4",
    "cors": "^2.8.6",
    "ethers": "^6.17.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "openai": "7.5.0",
    "viem": "^2.55.13",
    "@sentry/node": "^10.70.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.13",
    "eciesjs": "^0.5.0"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "license": "MIT"
}
