{
  "name": "@axiom/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Axiom Protocol orchestration engine + HTTP/WS server",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "prestart": "pnpm build",
    "dev": "node --import tsx src/index.ts",
    "test": "node --import tsx --test --test-concurrency=1 --test-force-exit $(find src test -name '*.test.ts' 2>/dev/null | sort)",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "pre-run-e2e": "pnpm --filter @axiom/oracle build && pnpm --filter @axiom/chat-runtime build && pnpm build",
    "run-e2e": "node --import tsx src/cli/run-e2e.ts",
    "run-chat-bench": "node --import tsx src/cli/run-chat-bench.ts",
    "run-chat-bench:live": "E2E_LIVE_COMPUTE=1 node --import tsx src/cli/run-chat-bench.ts",
    "run-load-bench": "node --import tsx src/cli/run-load-bench.ts",
    "coverage-status": "node --import tsx src/cli/coverage-status.ts",
    "provision-e2e-wallet": "node --import tsx src/cli/provision-e2e-wallet.ts",
    "fund-e2e-usdc": "node --import tsx src/cli/fund-e2e-usdc.ts"
  },
  "dependencies": {
    "@axiom/chat-runtime": "workspace:*",
    "@axiom/config": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "compression": "^1.7.4",
    "cors": "^2.8.6",
    "ethers": "^6.17.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "openai": "^7.4.0",
    "viem": "^2.55.11",
    "@sentry/node": "^10.69.0",
    "ws": "^8.21.3",
    "lru-cache": "^11.5.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axiom/oracle": "workspace:*",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.13",
    "eciesjs": "^0.5.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT"
}
