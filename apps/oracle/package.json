{
  "name": "@axiom/oracle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Axiom TEE signer service — signs ERC-7857 OwnershipProofs and re-encrypts agent metadata",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./signer": {
      "types": "./dist/signer.d.ts",
      "default": "./dist/signer.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "prestart": "pnpm build",
    "dev": "node --import tsx src/index.ts",
    "test": "AXIOM_DISABLE_AUTH=true AXIOM_ALLOW_CLEARTEXT_DEK=true node --import tsx --test $(find src test -name \"*.test.ts\" 2>/dev/null | sort)",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@axiom/config": "workspace:*",
    "@sentry/node": "^10.62.0",
    "cors": "^2.8.6",
    "ethereum-cryptography": "^2.2.1",
    "ethers": "^6.16.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.2.0",
    "viem": "^2.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.22.0",
  "license": "MIT"
}
