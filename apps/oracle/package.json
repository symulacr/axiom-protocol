{
  "name": "@axiom/oracle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Axiom TEE signer service — signs ERC-7857 OwnershipProofs and re-encrypts agent metadata",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./signer": {
      "types": "./dist/signer.d.ts",
      "default": "./dist/signer.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "bun dist/index.js",
    "prestart": "bun run build",
    "dev": "bun run src/index.ts",
    "test": "AXIOM_DISABLE_AUTH=true AXIOM_ALLOW_CLEARTEXT_DEK=true bun test --max-concurrency=1",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@axiom/config": "workspace:*",
    "@sentry/node": "^10.69.0",
    "cors": "^2.8.6",
    "ethereum-cryptography": "^3.2.0",
    "ethers": "^6.17.0",
    "express": "^4.21.0",
    "helmet": "^8.3.0",
    "viem": "^2.55.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "bun@1.4.0",
  "license": "MIT"
}
