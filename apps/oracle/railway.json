{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "bun run --filter @axiom/oracle build:binary"
  },
  "deploy": {
    "startCommand": "./dist/axiom-oracle",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicy": "ON_FAILURE"
  },
  "watchPatterns": ["apps/oracle/**", "packages/config/**"]
}
