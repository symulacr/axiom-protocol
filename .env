# Repo env — PUBLIC values only, committed (secrets live in Vercel Environment
# Variables; they overlay these at build time via build.mjs process.env
# precedence). Local dev keeps the same-origin /api proxy; production overrides
# VITE_BACKEND_URL + VITE_ORACLE_URL with the Railway backend in Vercel.
# R16: MAINNET (0G Aristotle, chainId 16661) — no testnet.
VITE_CHAIN_ID=16661
VITE_EVM_RPC=https://evmrpc.0g.ai
VITE_BACKEND_URL=/api
VITE_API_KEY=
VITE_ORACLE_URL=/oracle
VITE_CHAT_MODEL=deepseek-v4-flash
VITE_WALLETCONNECT_PROJECT_ID=
# 0G Aristotle mainnet deployment (production set, 2026-09-05 — matches the
# Vercel Production env block; GasTank + DelegationRegistry now deployed):
VITE_AGENT_NFT_ADDRESS=0xA7DC2A0F1329149BD9643b0fe0677a686eb0d8F2
VITE_PAYMENT_PROCESSOR_ADDRESS=0x9C9DB66AbDA3adb7C83480Ccb8729f94215ac6c2
VITE_STRATEGY_VAULT_ADDRESS=0x9dD615F93e3ae7FfDC69D47DC4bBF4027D28616C
VITE_TEE_VERIFIER_ADDRESS=0x1424874A80D92D30A7d85AD8Ce9Bb370f35efD43
VITE_DELEGATION_REGISTRY_ADDRESS=0xAB1E333C498cd739120cEA9b44c71bea1f4891Fe
VITE_GAS_TANK_ADDRESS=0x156D05Ea7D47Da0a264C43855240c91F8eA8c4B6
# Payment token is NOT a frontend env var: usePayment reads it from the
# backend /v1 payment config at runtime (VITE_PAYMENT_TOKEN_ADDRESS is unused
# by the SPA).
