{
  "$schema": "https://railway.com/railway.schema.json",
  "services": {
    "axiom-backend": {
      "build": {
        "buildCommand": "bun run --filter @axiom/config build && bun run --filter @axiom/chat-runtime build && bun run --filter @axiom/backend build"
      },
      "deploy": {
        "startCommand": "bun apps/backend/dist/index.js",
        "healthcheckPath": "/health",
        "healthcheckTimeout": 120,
        "restartPolicy": "ON_FAILURE"
      },
      "watchPatterns": [
        "apps/backend/**",
        "packages/config/**",
        "packages/chat-runtime/**"
      ]
    },
    "axiom-frontend": {
      "build": {
        "buildCommand": "bun run --filter @axiom/config build && bun run --filter @axiom/chat-runtime build && bun run --filter @axiom/frontend build"
      },
      "deploy": {
        "startCommand": "bun apps/frontend/server.mjs",
        "healthcheckPath": "/",
        "healthcheckTimeout": 120,
        "restartPolicy": "ON_FAILURE"
      },
      "watchPatterns": [
        "apps/frontend/**",
        "packages/config/**",
        "packages/chat-runtime/**"
      ]
    },
    "oracle": {
      "build": {
        "buildCommand": "bun run --filter @axiom/config build && bun run --filter @axiom/oracle build"
      },
      "deploy": {
        "startCommand": "bun apps/oracle/dist/index.js",
        "healthcheckPath": "/health",
        "healthcheckTimeout": 120,
        "restartPolicy": "ON_FAILURE"
      },
      "watchPatterns": [
        "apps/oracle/**",
        "packages/config/**"
      ]
    }
  }
}
