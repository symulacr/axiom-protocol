{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "bun run --filter @axiom/config build && bun run --filter @axiom/chat-runtime build && bun run --filter @axiom/frontend build",
  "outputDirectory": "apps/frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "${BACKEND_ORIGIN}/:path*"
    },
    {
      "source": "/api",
      "destination": "${BACKEND_ORIGIN}/"
    },
    {
      "source": "/oracle/:path*",
      "destination": "${BACKEND_ORIGIN}/oracle/:path*"
    },
    {
      "source": "/oracle",
      "destination": "${BACKEND_ORIGIN}/oracle/"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
