# ─── Axiom Protocol — centralized environment template ───────────────
# Single source of truth for every service: backend, frontend, oracle,
# contracts, indexer, and CI. Copy to `.env` (gitignored) and fill values.
# Never commit real secrets — CI reads keys from GitHub repo secrets.

# ─── Chain (0G Galileo Testnet, chainId 16602) ──────────────────────
AXIOM_EVM_RPC=https://evmrpc-testnet.0g.ai
AXIOM_CHAIN_ID=16602
AXIOM_STORAGE_RPC=https://indexer-storage-testnet-turbo.0g.ai
AXIOM_STORAGE_INDEXER_RPC=https://indexer-storage-testnet-turbo.0g.ai
AXIOM_STORAGE_EVM_RPC=https://evmrpc-testnet.0g.ai

# ─── Backend (port 3000) ────────────────────────────────────────────
AXIOM_PORT=3000
AXIOM_BIND=0.0.0.0
AXIOM_API_KEY=
AXIOM_BACKEND_URL=http://127.0.0.1:3000
AXIOM_FRONTEND_URL=http://127.0.0.1:5173
# local dev only - disables API-key auth (never in production)
AXIOM_DISABLE_AUTH=true
AXIOM_RATE_LIMIT_MAX=50000
AXIOM_HEALTH_CACHE_MS=3000
AXIOM_AGENT_LIST_CACHE_MS=30000
AXIOM_CHAT_STREAM_TIMEOUT_MS=60000
AXIOM_DATA_DIR=./data
AXIOM_SENTRY_DSN=

# ─── Oracle (TEE signer, port 8787) ────────────────────────────────
AXIOM_ORACLE_URL=http://127.0.0.1:8787
AXIOM_ORACLE_PORT=8787
AXIOM_ORACLE_BIND=127.0.0.1
AXIOM_TEE_SIGNER_PK=0x<oracle_signer_private_key>
AXIOM_TEE_VERIFIER=
AXIOM_TEE_VERIFIER_ADDRESS=

# ─── Compute (0G Compute Network) ──────────────────────────────────
AXIOM_COMPUTE_BASE_URL=https://router-api-testnet.integratenetwork.work/v1
AXIOM_COMPUTE_API_KEY=sk-...
AXIOM_COMPUTE_MODEL=deepseek-v4-flash
AXIOM_COMPUTE_DEPOSIT_AMOUNT=0.01
AXIOM_COMPUTE_VERIFY_TEE=true

# ─── Contracts / deployment ─────────────────────────────────────────
AXIOM_DEPLOYER_ADDRESS=0x<deployer_address>
AXIOM_AGENT_NFT=0x6f82d061a903E48Ce1810F8d42536C6A837ed684
AXIOM_AGENT_NFT_ADDRESS=0x6f82d061a903E48Ce1810F8d42536C6A837ed684
AXIOM_NFT=
AXIOM_STRATEGY_VAULT=0xB30061Ea93b60FCbAE11C2b06FE3Db3C84FAA367
AXIOM_STRATEGY_VAULT_ADDRESS=0xB30061Ea93b60FCbAE11C2b06FE3Db3C84FAA367
AXIOM_PAYMENT_PROCESSOR=0x97a32707d948F91175706ca5509c7bfCC643a1dD
AXIOM_PAYMENT_PROCESSOR_ADDRESS=0x97a32707d948F91175706ca5509c7bfCC643a1dD
AXIOM_PAYMENT_TOKEN=0x354CA53bAB51C0666964fa050628d8351f8A7d19
AXIOM_MOCK_USDC_ADDRESS=0x354CA53bAB51C0666964fa050628d8351f8A7d19
AXIOM_ENCRYPTION_ALGORITHM=aes-256-gcm

# ─── E2E wallets (pnpm provision-e2e-wallet) ───────────────────────
DEPLOYER_PK=0x<deployer_private_key>
AXIOM_ORACLE_ADMIN_PK=0x<oracle_admin_private_key>
AXIOM_OPERATOR_PK=0x<operator_private_key>
AXIOM_TEST_RECEIVER_1_PK=0x<receiver1_private_key>
AXIOM_TEST_RECEIVER_2_PK=0x<receiver2_private_key>
E2E_OPERATOR_PK=0x<e2e_operator_private_key>
E2E_OPERATOR_ADDRESS=0x<e2e_operator_address>
E2E_RECEIVER_PK=0x<e2e_receiver_private_key>
E2E_RECEIVER_ADDRESS=0x<e2e_receiver_address>
RECEIVER_PK=0x<receiver_private_key>
E2E_PARITY_MIN_PCT=90
E2E_STRICT_FUNDING=0
FOUNDRY_LIVE_FORK=0
E2E_USDC_MINT_AMOUNT_HUMAN=1000000

# ─── Frontend (Vite, port 5173) ────────────────────────────────────
VITE_BACKEND_URL=http://127.0.0.1:3000
VITE_API_KEY=
VITE_ORACLE_URL=http://127.0.0.1:8787
VITE_CHAT_MODEL=deepseek-v4-flash
VITE_WALLETCONNECT_PROJECT_ID=
# Deployed contract addresses consumed by the frontend (must match backend)
VITE_AGENT_NFT_ADDRESS=0x6f82d061a903E48Ce1810F8d42536C6A837ed684
VITE_STRATEGY_VAULT_ADDRESS=0xB30061Ea93b60FCbAE11C2b06FE3Db3C84FAA367
VITE_TEE_VERIFIER_ADDRESS=0x63Edfd4CD68A77AEdC4A56550Ae94e7F86d497B7
VITE_PAYMENT_PROCESSOR_ADDRESS=0x97a32707d948F91175706ca5509c7bfCC643a1dD
VITE_MOCK_USDC_ADDRESS=0x354CA53bAB51C0666964fa050628d8351f8A7d19

# ─── Indexer ───────────────────────────────────────────────────────
INDEXER_DA_ENABLED=false
HEALTH_PORT=9091

# ─── CI (GitHub repo secrets — NOT committed) ──────────────────────
# ci.yml reads these via ${{ secrets.* }}. Set them in
# Settings → Secrets and variables → Actions. For the public Anvil
# testnet use the default keys:
#   DEPLOYER_PK         = Anvil account #0 (0xac0974...f2ff80)
#   E2E_RECEIVER_PK     = Anvil account #1 (0x59c6995e...78690d)
#   RECEIVER_PK         = Anvil account #1
#   AXIOM_TEE_SIGNER_PK = Anvil account #1
