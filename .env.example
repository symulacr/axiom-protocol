# ─── Axiom Protocol — centralized environment template ───────────────
# Single source of truth for every service: backend, frontend, oracle,
# contracts, indexer, and CI. Copy to `.env` (gitignored) and fill values.
# The frontend reads VITE_* vars from this same root .env via
# apps/frontend/vite.config.ts `envDir` — apps/frontend/.env is obsolete
# and must NOT be recreated with per-app copies.
# Never commit real secrets — CI reads keys from GitHub repo secrets.

# ─── Chain (0G Galileo Testnet, chainId 16602) ───────────────────
# Storage endpoints must match AXIOM_CHAIN_ID (16602=testnet, 16661=mainnet) —
# a mainnet indexer/EVM RPC with a Galileo-funded signer makes every 0G Storage
# upload fail with "insufficient funds" (wrong Flow contract).
AXIOM_EVM_RPC=https://evmrpc-testnet.0g.ai
AXIOM_CHAIN_ID=16602
AXIOM_STORAGE_RPC=https://indexer-storage-testnet-turbo.0g.ai
AXIOM_STORAGE_INDEXER_RPC=https://indexer-storage-testnet-turbo.0g.ai
AXIOM_STORAGE_EVM_RPC=https://evmrpc-testnet.0g.ai

# ─── Backend (port 3000) ────────────────────────────────────────────
AXIOM_PORT=3000
AXIOM_BIND=0.0.0.0
# API-key auth is ON by default. Set a strong value in production; only
# AXIOM_DISABLE_AUTH=true opts out (local dev only — never in production).
AXIOM_API_KEY=change-me-in-production
# Browser-safe key (optional). Can call read/encode/chat; CANNOT vault execute.
AXIOM_CLIENT_API_KEY=
AXIOM_BACKEND_URL=http://127.0.0.1:3000
# Must equal your deployed frontend origin in production
# (e.g. https://axiom-protocol.vercel.app). CORS and the CSP connect-src are
# derived from this; if unset, cross-origin calls are denied (fail-closed).
AXIOM_FRONTEND_URL=http://127.0.0.1:5173
# Local dev only — disables API-key auth. MUST be false (or unset) in production.
AXIOM_DISABLE_AUTH=false
# Per-minute rate-limit ceiling. Low sane default; raise only with justification.
AXIOM_RATE_LIMIT_MAX=100
# Dedicated backend runtime signer. MUST differ from DEPLOYER_PK in production so
# the deployer/upgrader key never lives in the long-running backend process.
AXIOM_RUNTIME_SIGNER_PK=0x<runtime_signer_private_key>
AXIOM_HEALTH_CACHE_MS=3000
AXIOM_AGENT_LIST_CACHE_MS=30000
AXIOM_CHAT_STREAM_TIMEOUT_MS=60000
AXIOM_DATA_DIR=./data
AXIOM_SENTRY_DSN=

# ─── Oracle (in-process TEE signer) ─────────────────────────────────
# TEE signer private key (the simulated-TEE secp256k1 key). For local dev use
# the devnet key in wallets/tee-signer.json — its derived address MUST equal the
# AxiomTeeVerifier `registeredSigner`. In production use a dedicated key.
AXIOM_TEE_SIGNER_PK=0x<oracle_signer_private_key>
# e2e alias (run-e2e.ts reads bare TEE_SIGNER_PK); value must equal AXIOM_TEE_SIGNER_PK.
TEE_SIGNER_PK=0x<oracle_signer_private_key>
# Never set true in production. Test-only cleartext DEK on transfer-validity.
AXIOM_ALLOW_CLEARTEXT_DEK=false
# EIP-712 verifyingContract for TEE proofs. MUST equal the deployed
# AxiomTeeVerifier proxy on 0G Galileo testnet
# (docs/deployments/galileo-merged-2026-08-13.json) and VITE_TEE_VERIFIER_ADDRESS.
# If left empty the backend cannot build the EIP-712 domain and fails to boot
# (ZodError: "Invalid address" / "Missing AXIOM_TEE_VERIFIER_ADDRESS").
AXIOM_TEE_VERIFIER_ADDRESS=0x72a381226E09b9AAe15D9309A656d7e5DD2bFbb2
# Deprecated alias — only if you still read AXIOM_TEE_VERIFIER.
AXIOM_TEE_VERIFIER=0x1ba37125bba23b66b549ccb33bc9b4952fd4dcc4

# ─── Compute (0G Compute Network) ──────────────────────────────────
# CHAIN-DRIVEN when unset — router URL and default chat model both derive from
# AXIOM_CHAIN_ID via packages/config/src/networks.ts:
#   16602 (Galileo testnet) → router https://router-api-testnet.integratenetwork.work/v1,
#                            default model qwen2.5-omni (catalog: qwen2.5-omni, qwen-image-edit)
#   16661 (Aristotle mainnet) → router https://router-api.0g.ai/v1,
#                              default model deepseek-v4-flash (28-model catalog)
# Explicit values below always win over the chain defaults; the key MUST match the
# chain's router (a testnet key against the mainnet router 401s and vice versa).
# The backend logs the effective wiring at boot: `[boot] compute: chain=… router=… model=… key=sk-XXXX…XXXX (router)`.
# AXIOM_COMPUTE_BASE_URL=https://router-api.0g.ai/v1
# Get a key from the 0G compute provider dashboard (testnet + mainnet keys differ).
# model deepseek-v4-flash = pinned 2026-07-31 snapshot (API has no -0731 suffix);
# pricing ~0.866 0G prompt / 1.72 0G completion per 1M tokens
AXIOM_COMPUTE_API_KEY=sk-<compute_api_key>
# AXIOM_COMPUTE_MODEL=deepseek-v4-flash
# Allow multiple backend processes to share EventStore files (unsafe). Default: exclusive lock.
# AXIOM_ALLOW_MULTI_INSTANCE=false

# Frontend production reverse-proxy (apps/frontend/server.mjs) — required in prod:
# PROXY_BACKEND_URL=https://your-backend.example
# (PROXY_ORACLE_URL no longer needed — /oracle* is served by the backend)

# ─── Contracts / deployment ─────────────────────────────────────────
AXIOM_DEPLOYER_ADDRESS=0x<deployer_address>
AXIOM_AGENT_NFT=0x4e57e954D82A99Ee94c48e1bc804bA9D131a3622
AXIOM_AGENT_NFT_ADDRESS=0xdBB2e63807a13272789B716692fbe0d09E010097
AXIOM_NFT=
AXIOM_STRATEGY_VAULT=0x4D0A123fbb83F7a5f137ec0B720a5D69fCB52251
AXIOM_STRATEGY_VAULT_ADDRESS=0x4607D749a7b8BBD2593742F8432410231C805c57
AXIOM_PAYMENT_PROCESSOR=0x9cDeDd99fe5F2E25f30920e092fC1C586716c0eC
AXIOM_PAYMENT_PROCESSOR_ADDRESS=0x7490D693364A31E0513bcef8E346397cc4BA9E9c
AXIOM_PAYMENT_TOKEN=0x354CA53bAB51C0666964fa050628d8351f8A7d19
AXIOM_MOCK_USDC_ADDRESS=0x354CA53bAB51C0666964fa050628d8351f8A7d19
AXIOM_ENCRYPTION_ALGORITHM=aes-256-gcm

# ─── E2E wallets (bun run provision-e2e-wallet) ──────────────────────
DEPLOYER_PK=0x<deployer_private_key>
AXIOM_OPERATOR_PK=0x<operator_private_key>
AXIOM_TEST_RECEIVER_1_PK=0x<receiver1_private_key>
AXIOM_TEST_RECEIVER_2_PK=0x<receiver2_private_key>
E2E_OPERATOR_PK=0x<e2e_operator_private_key>
E2E_OPERATOR_ADDRESS=0x<e2e_operator_address>
E2E_RECEIVER_PK=0x<e2e_receiver_private_key>
E2E_RECEIVER_ADDRESS=0x<e2e_receiver_address>
RECEIVER_PK=0x<receiver_private_key>
E2E_PARITY_MIN_PCT=90
E2E_STRICT_FUNDING=0
FOUNDRY_LIVE_FORK=0
E2E_USDC_MINT_AMOUNT_HUMAN=1000000

# Opt-in for the backend e2e harness: lets signalSource "manual:e2e*" tick
# requests skip compute inference. Requires the server API key too.
# NEVER set this in production — leave unset (default denied).
#AXIOM_ALLOW_E2E_MOCK_TICKS=1

# ─── Frontend (Vite, port 5173) ────────────────────────────────────
# Chain selection for wallet flows (must match AXIOM_CHAIN_ID + addresses):
# 16602 = Galileo testnet (evmrpc-testnet.0g.ai), 16661 = Aristotle mainnet.
VITE_CHAIN_ID=16602
VITE_EVM_RPC=https://evmrpc-testnet.0g.ai
VITE_BACKEND_URL=http://127.0.0.1:3000
VITE_API_KEY=
# Same-origin /oracle surface (in-process TEE signer) — keep relative
VITE_ORACLE_URL=/oracle
VITE_CHAT_MODEL=deepseek-v4-flash
VITE_WALLETCONNECT_PROJECT_ID=
# Deployed contract addresses consumed by the frontend (must match backend)
VITE_AGENT_NFT_ADDRESS=0xdBB2e63807a13272789B716692fbe0d09E010097
VITE_STRATEGY_VAULT_ADDRESS=0x4607D749a7b8BBD2593742F8432410231C805c57
VITE_TEE_VERIFIER_ADDRESS=0x72a381226E09b9AAe15D9309A656d7e5DD2bFbb2
VITE_PAYMENT_PROCESSOR_ADDRESS=0x7490D693364A31E0513bcef8E346397cc4BA9E9c
VITE_MOCK_USDC_ADDRESS=0x354CA53bAB51C0666964fa050628d8351f8A7d19

# ─── Indexer ───────────────────────────────────────────────────────
HEALTH_PORT=9091

# ─── CI (GitHub repo secrets — NOT committed) ──────────────────────
# ci.yml reads these via ${{ secrets.* }}. Set them in
# Settings → Secrets and variables → Actions. For the public Anvil
# testnet use the default keys:
#   DEPLOYER_PK         = Anvil account #0 (0xac0974...f2ff80)
#   E2E_RECEIVER_PK     = Anvil account #1 (0x59c6995e...78690d)
#   RECEIVER_PK         = Anvil account #1
#   AXIOM_TEE_SIGNER_PK = Anvil account #1

# ─── Backend (optional) ─────────────────────────────
AXIOM_INDEXER_API_KEY=
OG_COMPUTE_API_KEY=
AXIOM_COMPUTE_SIGNER_PK=

# ─── OSINT skills (optional paid tokens) ────────────
# Passed upstream only when set; without them the skills stay callable via
# their free/anonymous tiers (readable 502 on throttling, unchanged).
# OpenCorporates → ?api_token=  ·  CourtListener → Authorization: Token
COURTLISTENER_API_TOKEN=

# ─── Indexer ────────────────────────────────────────
INDEXER_HEALTH_PORT=9091
INDEXER_START_BLOCK=
INDEXER_POLL_WINDOW_BLOCKS=500
